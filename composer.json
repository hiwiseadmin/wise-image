{
    "name": "wiseadmin/wise-image",
    "description": "WiseAdmin 图片处理包 — 支持 GD/Imagick 双驱动、阿里云 OSS 风格参数处理、防盗链与签名验证",
    "homepage": "https://github.com/hiwiseadmin/wise-image",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "thinkphp",
        "image",
        "gd",
        "imagick",
        "wiseadmin"
    ],
    "authors": [
        {
            "name": "WiseAdmin Team",
            "email": "wiseadmin@126.com"
        }
    ],
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0",
        "mockery/mockery": "^1.5",
        "topthink/framework": "^6.0 || ^8.0"
    },
    "suggest": {
        "ext-imagick": "用于 Imagick 驱动，性能更优且支持更多格式"
    },
    "autoload": {
        "psr-4": {
            "wise\\image\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "wise\\image\\tests\\": "tests/"
        }
    },
    "extra": {
        "think": {
            "services": [
                "wise\\image\\Service"
            ],
            "config": {
                "wise-image": "config/wise-image.php"
            }
        }
    },
    "archive": {
        "exclude": [
            "/tests",
            "/docs",
            "/.github",
            "/phpunit.xml",
            "/.gitattributes",
            "/.gitignore",
            "/*.md",
            "!/README.md",
            "/qa/"
        ]
    }
}
